[Unit]
Description=AGIOS localhost website and preview VM manager
Wants=network-online.target
After=network-online.target agi-guacd.service
Requires=agi-guacd.service
ConditionKernelCommandLine=!agios.guest
[Service]
Type=simple
# A separate system user keeps the website's sudo rules limited to its helpers.
User=agi-web
Group=agi-web
SupplementaryGroups=kvm render video disk optical systemd-journal
StateDirectory=agi-os
StateDirectoryMode=0700
Environment=AGIOS_DATA_DIR=/var/lib/agi-os
ExecStart=/usr/bin/python -B /usr/local/share/agi-os/web/server.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=7500
[Install]
WantedBy=multi-user.target
