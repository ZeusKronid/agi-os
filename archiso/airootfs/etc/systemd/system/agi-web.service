[Unit]
Description=AGIOS localhost website and preview VM manager
Wants=network-online.target
After=network-online.target agi-guacd.service agi-test-workspace.service
Requires=agi-guacd.service
[Service]
Type=simple
User=agi
Group=agi
SupplementaryGroups=kvm render video
StateDirectory=agi-os
Environment=AGIOS_DATA_DIR=/var/lib/agi-os
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/agi/.Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/python -B /usr/local/share/agi-os/web/server.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=7500
[Install]
WantedBy=multi-user.target
