#!/bin/sh
# The user interface lives in this booted Live environment.
for attempt in $(seq 1 60); do
    curl -fsS http://127.0.0.1:8787/api/state >/dev/null 2>&1 && break
    sleep 1
done
# The new window stands on the wallpaper's horizon, under the sunrise, once it appears.
agi-desktop place $(wmctrl -l 2>/dev/null | awk '{print $1}') &
exec firefox --new-window http://localhost:8787
